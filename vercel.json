{
    "services": {
        "frontend": {
            "root": ".",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "server.js"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://runny-unsentiently-teresita.ngrok-free.dev/api/$1"
        },
        {
            "source": "/uploads/(.*)",
            "destination": "https://runny-unsentiently-teresita.ngrok-free.dev/uploads/$1"
        },
        {
            "source": "/((?!api|uploads)[^.]*)",
            "destination": "/index.html"
        },
        {
            "source": "/index.html",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}
